{
    "markdownlint.config": {
        "default": true,
        "line_length": false
    },

    "languageserver": {
        "csharp-ls": {
          "command": "csharp-ls",
          "filetypes": ["cs"],
          "rootPatterns": ["*.csproj", ".vim/", ".git/", ".hg/"]
        }
    },

    "suggest.noselect": true
}

